    "admin:password": "node server/tools/hash-password.mjs",
    "telegram:setup": "node server/tools/telegram-setup.mjs",
    "telegram:check": "node server/tools/telegram-setup.mjs --check",
    "telegram:test": "node server/tools/telegram-setup.mjs --test"
