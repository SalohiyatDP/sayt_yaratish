# Qurilgan statik sayt (build natijasi)
/dist/

# Mahalliy sozlamalar va maxfiy ma'lumotlar
.env
.env.local
server/data/session-secret
server/data/admin-users.json

# Telegram bot sozlamalari (bot tokeni maxfiy!)
server/data/telegram.json

# Kontentning avtomatik zaxira nusxalari (serverda saqlanadi)
server/data/backups/

# Murojaatlar qutisi (shaxsiy ma'lumotlar saqlanadi — hech qachon repozitoriyaga tushmasligi kerak)
/content/inbox/*
!/content/inbox/.gitkeep

# Boshqaruv paneli orqali yuklangan fayllar (og'ir media)
/assets/uploads/*
!/assets/uploads/.gitkeep

# Tizim fayllari
.DS_Store
Thumbs.db
*.log
npm-debug.log*
node_modules/
