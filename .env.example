# ============================================================================
#  Namuna sozlamalar fayli.
#
#  Foydalanish:
#    1. Bu faylni `.env` nomi bilan nusxalang
#    2. Kerakli qiymatlarni to'ldiring
#    3. Serverni qayta ishga tushiring
#
#  `.env` fayli `.gitignore` ro'yxatida — repozitoriyaga TUSHMAYDI.
#  Bot tokenini hech kimga bermang va xat/messenjer orqali yubormang.
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────

# Server tinglaydigan port (sukut bo'yicha 8080)
PORT=8080

# Tinglash manzili. Teskari proksi (nginx) ortida 127.0.0.1 tavsiya etiladi.
HOST=127.0.0.1

# Saytning to'liq manzili — Telegram xabaridagi «Boshqaruv paneli» tugmasi uchun.
# Bo'sh bo'lsa content/site.json -> seo.canonicalOrigin qiymati ishlatiladi.
# SITE_ORIGIN=https://sayt-manzili.uz


# ── Telegram bot ────────────────────────────────────────────────────────────

# Bot tokeni. @BotFather dan olinadi: /newbot yoki /token
# Ko'rinishi: 1234567890:AAEhBOweik6ad9r_QXzR1_ABCdefGhIJklm
TELEGRAM_BOT_TOKEN=

# Murojaatlar keladigan chat identifikatori.
#   • shaxsiy chat:  123456789
#   • guruh:         -1001234567890
#   • kanal:         @kanal_nomi
# Aniqlash uchun: node server/tools/telegram-setup.mjs
TELEGRAM_CHAT_ID=

# Forum ko'rinishidagi guruhda aniq mavzuga (topic) yuborish uchun — ixtiyoriy
# TELEGRAM_THREAD_ID=

# Telegramga yuborishni vaqtincha to'xtatish (murojaatlar qutida saqlanishda davom etadi)
# TELEGRAM_DISABLED=1

# Telegram API manzili. Odatda o'zgartirilmaydi.
# Faqat sinov (mock) serveri bilan ishlaganda kerak bo'ladi.
# TELEGRAM_API_BASE=https://api.telegram.org
