# Standart: matn fayllarini avtomatik aniqlash, repozitoriyada LF saqlash
* text=auto eol=lf

# Windows buyruq fayllari CRLF bilan saqlanadi — aks holda cmd.exe xato o'qishi mumkin
*.cmd text eol=crlf
*.bat text eol=crlf

# Ikkilik (binary) fayllar
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.pdf binary
*.zip binary
*.woff2 binary
